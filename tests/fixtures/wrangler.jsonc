{
  "name": "scs-test-fixture",
  "main": "worker.ts",
  "compatibility_date": "2026-07-11",
  "assets": {
    "directory": "../../dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__fixture/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scs-test-fixture",
      "database_id": "test-fixture-only-auth-v2",
      "migrations_dir": "../../migrations",
    },
  ],
  "r2_buckets": [{ "binding": "EVIDENCE_BUCKET", "bucket_name": "scs-evidence-test-fixture" }],
  "vars": { "COGNITO_ISSUER": "", "COGNITO_CLIENT_ID": "", "COGNITO_JWKS_URL": "" },
}
